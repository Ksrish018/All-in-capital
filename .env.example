# All In Capital triage system: environment variables
# Copy this file to .env and paste your real keys there. Never commit .env.

# 1. Main LLM: Google Gemini (scoring, extraction, drafting). Eval judge model to be decided later.
GEMINI_API_KEY=

MODEL_JUDGE_CRITERIA=gemini-3.1-pro-preview
MODEL_EXTRACT=gemini-3.1-flash-lite
MODEL_DRAFT=gemini-3-flash-preview

# 2. Cloudflare AI Gateway (every model call goes through it: retries, caching, logs, cost)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
# Only needed if the gateway has Authenticated Gateway turned on
CLOUDFLARE_AIG_TOKEN=

# 3. Langfuse tracing (EU cloud). Use the latest Langfuse SDK, which sends traces via OpenTelemetry.
#    The old /api/public/ingestion endpoint was switched off on 19 Nov 2026.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 4. Web research (search and clean page extraction)
TAVILY_API_KEY=

# 5. Database and queue (Supabase). New-style keys. Legacy anon and service_role keys retire in early 2027.
SUPABASE_URL=
# Publishable key: safe in the browser only with Row Level Security on (it is on by default here)
SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only, never sent to the browser
SUPABASE_SECRET_KEY=
# Database connection for migrations (session pooler, region ap-northeast-1)
SUPABASE_DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
# Database password (for direct Postgres connections and migrations)
SUPABASE_DB_PASSWORD=

# 6. Gmail and Google Calendar (OAuth web client in Google Cloud project allin-triage, audience Internal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token for the dev account (from the one-time consent test)
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 7. Cost control
DAILY_COST_CAP_USD=5

# 8. App sign-in allow list (seeded into allowed_emails by npm run db:seed)
ADMIN_EMAIL=
RIYA_EMAIL=
KUSHAL_EMAIL=
ADITYA_EMAIL=
